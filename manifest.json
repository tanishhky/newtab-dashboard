{
  "manifest_version": 3,
  "name": "Dashboard",
  "version": "1.0.0",
  "description": "Private new tab: tasks, focus timer, deadlines, and application pipeline. Everything stays in this browser.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "js/gmail_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/gargantua-16.png",
    "32": "icons/gargantua-32.png",
    "48": "icons/gargantua-48.png",
    "128": "icons/gargantua-128.png"
  }
}
